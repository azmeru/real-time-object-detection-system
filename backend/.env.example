APP_NAME="Real-Time Object Detection Platform"
APP_VERSION="1.0.0"
DEBUG=false

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/detection_db

YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45

ONNX_MODEL_PATH=models/yolov8n.onnx

OPENVINO_MODEL_PATH=models/yolov8n_openvino_model
OPENVINO_DEVICE=CPU
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
